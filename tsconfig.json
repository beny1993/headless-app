{
  "compilerOptions": {
    // ES2022, not Next's legacy ES2017 default: money is integer Toman held as
    // bigint, and bigint literals need ES2020+. Node 24 and every browser this
    // ships to are well past it.
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // vitest.config.ts imports `./scripts/load-env.ts` with its extension: Vite's
    // native config loader (its planned default) cannot resolve an extensionless
    // relative import, and warns about it on every run.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next/dev", "design"]
}
