# Copy to .env and fill in. Every name here exists in the `VARS` enum in
# src/lib/utils/env.ts or is consumed by docker-compose-dev.yaml.

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string used by the app (Drizzle) and drizzle-kit.
APP_CONFIG_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54323/smokey-shop

# Credentials the dev Docker Postgres is created with — must match the URL above.
APP_CONFIG_DATABASE_USERNAME=postgres
APP_CONFIG_DATABASE_PASSWORD=postgres
APP_CONFIG_DATABASE_NAME=smokey-shop
# Host port for the dev container. Non-default so it never clashes with a system
# Postgres (5432) or another local project's container.
APP_CONFIG_DATABASE_PORT=54323

# ── Secrets ──────────────────────────────────────────────────────────────────
# Better Auth signing secret. Generate with: openssl rand -hex 32
APP_CONFIG_AUTH_SECRET=

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. Better Auth's baseURL and the API client
# read it; inlined into the client bundle at build time — so in production it must be
# a *build* argument, not a runtime container variable, or it will not take.
# Required in production (the app refuses to fall back to localhost there), and
# it must be the https:// URL: Better Auth derives both its trusted origins and
# the `Secure` flag on the session cookie from this value.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SMS (one-time sign-in codes) ──────────────────────────────────────────────
# `console` writes codes to the server log instead of sending them. It is the
# shipped default and what makes the whole site work locally with no provider
# account. `smsir` is the real provider — SMS.ir's verify service, which is
# where OTP is routed (the bulk/line-number API is for marketing sends and is
# carrier-filtered for codes). An unrecognized value throws at send time rather
# than silently sending nothing.
APP_CONFIG_SMS_PROVIDER=console
# Required only when APP_CONFIG_SMS_PROVIDER=smsir. The web-service key from the
# SMS.ir panel (sent as `x-api-key`), and the numeric id of the template the
# code is substituted into — its body must contain `#OTP#`. If the panel's IP
# restriction is on, list the server's outbound IPv4 there, or SMS.ir refuses
# the send.
APP_CONFIG_SMSIR_API_KEY=
APP_CONFIG_SMSIR_TEMPLATE_ID=
# The second template: the new-order alert every admin with a phone number gets.
# Its body must contain #ORDER#, #AMOUNT# and #METHOD#. Unset is fine — sign-in
# keeps working and only the alert fails (loudly, into Sentry), which is what
# lets the SMS.ir switch happen before this template has been approved.
APP_CONFIG_SMSIR_ORDER_TEMPLATE_ID=
# `true` also shows the code on the login page itself — the local and staging
# default, since the console driver otherwise leaves it in the server log where
# nobody testing from a phone can read it.
# NEVER `true` in production: it hands the code to whoever asked for it, which
# is a full sign-in bypass. It is ignored unless the provider above is
# `console`, so a real SMS environment cannot be turned into an oracle by this
# flag alone.
APP_CONFIG_SHOW_OTP_IN_UI=true

# ── Maintenance mode ─────────────────────────────────────────────────────────
# `true` shows every storefront page as «به‌زودی برمی‌گردیم» to everyone but a
# signed-in admin, who sees the real site. `/login` and `/admin-panel` stay
# open. Runtime: change it in Coolify and restart, no rebuild. Off by default.
APP_CONFIG_MAINTENANCE_MODE=false

# ── Payments (Zarinpal) ───────────────────────────────────────────────────────
# `mock` (the default) simulates the full Zarinpal flow locally — request,
# redirect to a dev-only mock gateway page (Pay / Fail / Abandon), callback and
# verify — so checkout works end to end on local and test deployments with no
# gateway account. The real v4 HTTP driver ships in the repo but stays inert
# until this is set to `zarinpal` AND a merchant id is provided. An unrecognized
# value throws rather than silently mocking.
APP_CONFIG_ZARINPAL_PROVIDER=mock
# Zarinpal merchant id (a UUID from the Zarinpal panel). Required only when
# APP_CONFIG_ZARINPAL_PROVIDER=zarinpal.
APP_CONFIG_ZARINPAL_MERCHANT_ID=
# true → route the real driver at sandbox.zarinpal.com instead of the live host.
APP_CONFIG_ZARINPAL_SANDBOX=false
# true → shoppers can pick online payment at checkout. Off by default: the
# Zarinpal option shows disabled and card to card is preselected. Runtime:
# change it in Coolify and restart, no rebuild. The E2E suite pins it on.
APP_CONFIG_ZARINPAL_ENABLED=false

# ── Storage (product & content image uploads) ────────────────────────────────
# `local` (the default) stores uploaded images on the local filesystem and serves
# them from /uploads/*, so image upload works locally and on test deployments
# with no object-storage account. `s3` uses the S3-compatible (Liara/Arvan) driver
# below — production, so uploads survive a redeploy. An unrecognized value throws
# rather than silently storing nothing.
APP_CONFIG_STORAGE_PROVIDER=local
# Where the `local` driver keeps uploaded files. Relative to the working
# directory; kept out of public/ and out of git. Absolute paths are fine too.
APP_CONFIG_STORAGE_LOCAL_ROOT=uploads
# S3-compatible object storage — required only when APP_CONFIG_STORAGE_PROVIDER=s3.
# Names follow Liara's platform convention. ENDPOINT is the host with no bucket.
LIARA_ENDPOINT=https://storage.c2.liara.site
LIARA_BUCKET_NAME=
LIARA_ACCESS_KEY=
LIARA_SECRET_KEY=
# Public READ base for uploaded objects. NEXT_PUBLIC_* is inlined at BUILD time,
# so the browser resolves image URLs from this — it must be set when building the
# s3 image, and must equal ${LIARA_ENDPOINT}/${LIARA_BUCKET_NAME}. Leave empty for
# the local driver (images then resolve to the local /uploads/* route). The bucket
# must be set public (object-read, no listing) for these URLs to load.
NEXT_PUBLIC_STORAGE_BASE_URL=

# ── Email (React Email rendered, sent over SMTP via nodemailer) ───────────────
# false → emails are logged to the server console instead of sent; no SMTP
# account needed for local development.
APP_CONFIG_EMAIL_ENABLED=false
# SMTP host. Required only when APP_CONFIG_EMAIL_ENABLED=true.
APP_CONFIG_SMTP_SERVER=
# SMTP port. 465 switches the transport to implicit TLS; 587 uses STARTTLS.
APP_CONFIG_SMTP_PORT=587
# SMTP username.
APP_CONFIG_SMTP_USER=
# SMTP password.
APP_CONFIG_SMTP_PASSWORD=
# From address on outgoing mail.
APP_CONFIG_SMTP_SENDER_EMAIL=noreply@example.com

# ── Error monitoring (Sentry) ────────────────────────────────────────────────
# Empty (the default) disables Sentry entirely — a fresh clone and `pnpm test`
# report nothing, which is what they should do. A DSN is public by design; it
# identifies the project and grants no read access, which is why it is
# NEXT_PUBLIC_ and safe in the client bundle.
# NOTE: inlined at BUILD time into BOTH the client and the server bundles (it
# goes through STATIC_INLINED_VARS, i.e. static dot-access). Setting it only as a
# runtime container variable does nothing — it must be a build argument, like
# NEXT_PUBLIC_APP_URL. Verified: the literal appears in .next/static AND
# .next/server after a build.
# NOTE: the backend is GlitchTip (app.glitchtip.com), NOT sentry.io — the SDK is
# Sentry's, the protocol is shared, and sentry.io itself answers 403 from Iranian
# IPs. Paste the GlitchTip DSN here. See docs/DEPLOY.md §9.
# Production app only: staging leaves it empty and reports nothing.
NEXT_PUBLIC_SENTRY_DSN=
# Which deployment an event came from — `production`. Only the production app
# reports: staging leaves the DSN (and this) unset. Build-time, like the DSN.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# ── Web analytics (Umami) ─────────────────────────────────────────────────────
# Self-hosted Umami, one instance shared by every project
# (https://analytics.bendev.ir). Leave BOTH empty locally: the root layout then
# renders no script tag, so `pnpm dev` never posts pageviews into the real site.
# Both are build-time, like the Sentry pair — a runtime container variable does
# nothing. See docs/DEPLOY.md §1.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# The per-site id from the Umami dashboard (Settings -> Websites). Production
# app only: staging leaves both Umami values unset and ships no tracker.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

