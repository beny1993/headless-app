{
  "name": "smokey-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "app:dev": "docker compose --file docker-compose-dev.yaml up --wait && next dev",
    "postapp:dev": "docker compose --file docker-compose-dev.yaml down",
    "build": "next build",
    "build:local": "node scripts/build-local.mjs",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --ignore-unknown --write ./src",
    "format:check": "prettier --ignore-unknown --check ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "migration:generate": "drizzle-kit generate",
    "migration:migrate": "drizzle-kit migrate",
    "migrate": "pnpm migration:generate && pnpm migration:migrate",
    "migration:check": "drizzle-kit check",
    "migration:reset-dev": "docker compose --file docker-compose-dev.yaml down -v && docker compose --file docker-compose-dev.yaml up -d postgres --wait && pnpm migration:migrate",
    "drizzle-studio": "drizzle-kit studio",
    "create-admin": "tsx scripts/create-admin.ts",
    "seed-catalog": "tsx scripts/seed-catalog.ts",
    "seed-shipping": "tsx scripts/seed-shipping.ts",
    "verify-s3": "tsx scripts/verify-s3-storage.ts",
    "verify-sms": "tsx scripts/verify-sms.ts",
    "security:check": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@hono/zod-openapi": "^1.5.1",
    "@scalar/hono-api-reference": "^0.9.48",
    "@sentry/nextjs": "^10.73.0",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.6.26",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "lucide-react": "^0.563.0",
    "next": "^16.3.4",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.20.0"
}
