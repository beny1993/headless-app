{
  "name": "smokey-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "app:dev": "docker compose --file docker-compose-dev.yaml up --wait && next dev",
    "postapp:dev": "docker compose --file docker-compose-dev.yaml down",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --ignore-unknown --write ./src",
    "format:check": "prettier --ignore-unknown --check ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:email": "email dev --dir ./src/emails",
    "prepare": "husky",
    "migration:generate": "drizzle-kit generate",
    "migration:migrate": "drizzle-kit migrate",
    "migrate": "pnpm migration:generate && pnpm migration:migrate",
    "migration:check": "drizzle-kit check",
    "migration:reset-dev": "docker compose --file docker-compose-dev.yaml down -v && docker compose --file docker-compose-dev.yaml up -d postgres --wait && pnpm migration:migrate",
    "drizzle-studio": "drizzle-kit studio",
    "create-admin": "tsx scripts/create-admin.ts",
    "security:check": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@scalar/hono-api-reference": "^0.9.48",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "lucide-react": "^0.563.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.5.0",
    "@react-email/ui": "^6.9.2",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-email": "^6.9.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
